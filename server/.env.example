QAD_HOST=127.0.0.1
QAD_PORT=8443
QAD_CERT_FILE=certs/cert.pem
QAD_KEY_FILE=certs/key.pem

QAD_DATABASE_URL=postgresql+psycopg://qad:qad_dev_pw@127.0.0.1:5432/quantum_auth
QAD_REDIS_URL=redis://127.0.0.1:6379/0
QAD_STORAGE_DIR=./storage
QAD_STATIC_DIR=../web/dist

QAD_KMS_SOCKET=/home/youruser/.local/share/quantum-auth-kms/kms.sock

QAD_MAX_UPLOAD_MB=25
QAD_TOKEN_TTL_SECONDS=600
QAD_HANDSHAKE_TTL_SECONDS=30
QAD_MAX_PENDING_SESSIONS=5000

QAD_RATE_LIMIT_INIT_PER_MIN=120
QAD_RATE_LIMIT_REGISTER_PER_MIN=20
QAD_RATE_LIMIT_LOGIN_PER_MIN=60

QAD_LOG_LEVEL=INFO
QAD_LOG_JSON=true
